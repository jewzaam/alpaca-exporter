# Python virtual environment
VENV_DIR ?= .venv
PYTHON := python3
ifeq ($(OS),Windows_NT)
VENV_BIN := $(VENV_DIR)/Scripts
EXE := .exe
else
VENV_BIN := $(VENV_DIR)/bin
EXE :=
endif
VENV_PYTHON := $(VENV_BIN)/python$(EXE)
VENV_PIP := $(VENV_BIN)/pip$(EXE)
VENV_UV := $(VENV_BIN)/uv$(EXE)

# Coverage settings
COVERAGE_THRESHOLD ?= 70

# Colors for output
BLUE := \033[34m
